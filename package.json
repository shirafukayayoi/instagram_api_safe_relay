{
	"name": "instagram-api-safe-workspace",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A localhost-only, read-only relay for approved experiments with the Instagram Web client.",
	"scripts": {
		"build": "pnpm -r run build",
		"clean": "pnpm -r run clean",
		"dev:relay": "pnpm --filter instagram-api-safe-relay dev",
		"dev:dashboard": "pnpm --filter instagram-api-safe-dashboard dev",
		"start:relay": "pnpm --filter instagram-api-safe-relay start",
		"test": "pnpm -r run test",
		"test:live": "pnpm --filter instagram-api-safe-relay exec node --import tsx/esm ../../scripts/instagram-live-smoke.ts",
		"type-check": "pnpm -r run type-check",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"accounts:register": "pnpm --filter instagram-api-safe-relay exec tsx ../../scripts/register-http-account.ts"
	},
	"keywords": [
		"instagram",
		"playwright",
		"relay",
		"typescript"
	],
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@types/node": "^25.0.2",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"packageManager": "pnpm@11.5.0"
}
