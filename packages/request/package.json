{
  "name": "instagram-api-safe-request",
  "version": "0.1.0",
  "description": "Playwright 経由で Instagram の承認済み公開操作だけを呼び出すクライアント。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "instagram-api-safe-contracts": "workspace:*",
    "instagram-api-safe-inject": "workspace:*"
  },
  "peerDependencies": {
    "playwright": ">=1.60.0 <2"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "playwright": "^1.60.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "license": "MIT"
}
