{
  "name": "instagram-api-safe-relay",
  "version": "0.1.0",
  "description": "Localhost-only HTTP relay for named, read-only Instagram Web operations.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": { "instagram-api-safe-relay": "dist/server.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.4",
    "hono": "^4.11.0",
    "instagram-api-safe-contracts": "workspace:*",
    "instagram-api-safe-request": "workspace:*",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

