{
  "name": "instagram-api-safe-wxt",
  "version": "0.1.0",
  "description": "Instagram の承認済み公開操作用 WXT MAIN-world ブリッジ。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./src/module.ts",
      "development": "./src/module.ts",
      "import": "./dist/module.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "instagram-api-safe-contracts": "workspace:*",
    "instagram-api-safe-inject": "workspace:*"
  },
  "peerDependencies": {
    "wxt": ">=0.20.27 <1"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wxt": "0.20.27"
  },
  "license": "MIT"
}
